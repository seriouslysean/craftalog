{
  "name": "craftalog",
  "version": "1.0.1",
  "private": true,
  "description": "Craftalog - A Minecraft Recipe Catalog",
  "author": {
    "name": "Sean Kennedy",
    "email": "sean@codeserious.com",
    "url": "http://www.codeserious.com"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --deny-warnings . && tsx scripts/lint-astro-styles.ts",
    "format": "oxfmt . && prettier --write \"**/*.astro\" --log-level warn",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\" --log-level warn",
    "type-check": "astro check && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "parse": "tsx scripts/parse.ts",
    "validate": "tsx scripts/validate.ts",
    "vendor:init": "git submodule update --init --depth 1"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "astro": "7.3.4",
    "modern-normalize": "3.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
