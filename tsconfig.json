{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // scripts/, tests/, e2e/ and the Playwright/Vitest configs are plain Node
  // (run via tsx/Vitest/Playwright), not Astro site code, so they stay out
  // of `astro check`'s surface and are type-checked with Node's ambient
  // types via tsconfig.node.json instead (see `npm run type-check`).
  "exclude": [
    "dist",
    "vendor",
    "scripts/**",
    "tests/**",
    "e2e/**",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
